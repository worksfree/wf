\documentclass[$if(fontsize)${$fontsize$},$endif$a4paper]{article}

$if(lang)$
\usepackage{polyglossia}
\setmainlanguage{$lang$}
$endif$
\usepackage{fontspec}
\setmainfont{$mainfont$}
\setmonofont{$monofont$}
\usepackage{geometry}
\geometry{
  $if(geometry)$
  $geometry$
  $else$
  top=2.5cm, bottom=2.5cm, left=2cm, right=2cm
  $endif$
}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage{amsmath} % For math environments
\usepackage{amssymb} % For math symbols
\usepackage{graphicx} % For images
\usepackage{longtable} % For tables that span multiple pages
\usepackage{booktabs} % For better table rules
\usepackage{array} % For column types in tables
\usepackage{colortbl} % For colored table cells/rows

% Basic document setup
\linespread{$if(linestretch)${$linestretch$}$else$1.3$endif$}

% Page numbering
\pagestyle{fancy}
\fancyhf{} % Clear all header and footer fields
\fancyhead[R]{\large $header-text$}
\fancyfoot[C]{\large\thepage} % Page number in the center footer
\renewcommand{\headrulewidth}{0pt} % No header rule
\renewcommand{\footrulewidth}{0pt} % No footer rule

% Colors from CSS
\definecolor{blueborder}{HTML}{0D47A1}
\definecolor{greenborder}{HTML}{008000} % Assuming green from CSS
\definecolor{tableheader}{HTML}{D3D3D3}
\definecolor{darkgray}{HTML}{333333}
\definecolor{textgray}{HTML}{252525}

% Custom H1 style (approximating CSS)
\titleformat{\section}[block]
  {\centering\normalfont\fontsize{16pt}{19.2pt}\selectfont\bfseries\color{black}}
  {}
  {0pt}
  {}
  [\vspace{10pt}\hrule height 0.6mm width \textwidth \color{darkgray}] % 6px solid #333 border-bottom

% Custom H2 style (approximating CSS)
\titleformat{\subsection}[block]
  {\normalfont\fontsize{14pt}{16.8pt}\selectfont\bfseries\color{black}}
  {}
  {0pt}
  {\colorbox{blueborder}{\rule{0pt}{14pt}\rule{4pt}{0pt}}\hspace{10pt}} % 4px solid #0d47a1 border-left
  [\vspace{5pt}]

% Custom H3 style (approximating CSS)
\titleformat{\subsubsection}[block]
  {\normalfont\fontsize{13pt}{15.6pt}\selectfont\bfseries\color{textgray}}
  {}
  {0pt}
  {\colorbox{greenborder}{\rule{0pt}{13pt}\rule{4pt}{0pt}}\hspace{10pt}} % 4px solid green border-left
  [\vspace{5pt}]

% Table styling
\setlength{\arrayrulewidth}{0.4pt} % Border thickness
\arrayrulecolor{black} % Border color
\setlength{\tabcolsep}{6pt} % Padding between columns
\renewcommand{\arraystretch}{1.2} % Row height
\heavyrulewidth=0.8pt % For booktabs, if used

% Body text alignment (default is justified, CSS is left)
\raggedright

% Avoid page breaks inside certain environments (pandoc handles some of these)
\clubpenalty=10000 % Avoid orphans
\widowpenalty=10000 % Avoid widows
\interfootnotelinepenalty=10000 % Avoid page breaks in footnotes

% Start document
\begin{document}

$body$

\end{document}