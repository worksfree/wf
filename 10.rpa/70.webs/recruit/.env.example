# ============================================================
# .env.example  — 잡코리아 자동화 환경변수 샘플
# 이 파일을 복사해 .env 로 저장한 뒤 실제 값을 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요.
# ============================================================

# ── 잡코리아 기업회원 로그인 ──────────────────────────────
JOBKOREA_ID=your_id@example.com
JOBKOREA_PW=your_password

# ── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://rkycwfpkzorfpcxfvaqt.supabase.co
# service_role key (Python 스크립트 전용 — 절대 공개하지 마세요)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── 검색 설정 ────────────────────────────────────────────
# 콤마로 여러 키워드 지정 가능
SEARCH_KEYWORDS=법인영업,GFC,재무설계사
SEARCH_MAX_PAGES=3

# ── Chrome 프로필 경로 (세션 유지) ──────────────────────
# 기본값: 홈 디렉터리의 .jobkorea_profile
# PROFILE_DIR=C:\Users\USER\.jobkorea_profile

# ── 제안 메시지 템플릿 파일 경로 ────────────────────────
# 파일이 없으면 코드 내 기본 템플릿 사용
# PROPOSAL_TEMPLATE_FILE=proposal_template.txt

# ── 실행 옵션 ────────────────────────────────────────────
# headless=true 로 설정하면 화면 없이 실행 (서버/스케줄 실행용)
HEADLESS=false
# 후보자 1명 처리 후 대기 시간(초)
DELAY_BETWEEN_CANDIDATES=2
