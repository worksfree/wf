# ─────────────────────────────────────────────────────────────
# Real-DB 테스트용 환경변수 (Supabase Project B — 비프로덕션)
# 이 파일을 복사: cp .env.test.example .env.test
# .env.test 는 gitignore됨 — 절대 커밋 금지
# ─────────────────────────────────────────────────────────────

# Supabase Project B (test/staging 전용)
TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT_ID.supabase.co
TEST_SUPABASE_ANON=eyJ...anon_key...
TEST_SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# 테스트 계정 비밀번호 (테스트 DB에만 존재하는 계정)
TEST_USER_PASSWORD=TestPassword123!
TEST_ADMIN_PASSWORD=AdminPassword123!
