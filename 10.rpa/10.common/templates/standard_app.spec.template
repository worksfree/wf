# ==================== 사용자 홈 디렉토리 설정 ====================
def create_user_home_configs():
    """사용자 홈 디렉토리에 기본 설정 파일 생성"""
    import json
    from datetime import datetime
    
    home_dir = Path.home()
    wf_rpa_dir = home_dir / '.wf_rpa'
    
    # .wf_rpa 디렉토리 생성
    wf_rpa_dir.mkdir(exist_ok=True)
    
    # 설정 파일들 생성
    templates = get_user_config_templates()
    for filename, config_data in templates.items():
        config_file = wf_rpa_dir / filename
        
        # 기존 파일이 있으면 백업
        if config_file.exists():
            backup_file = wf_rpa_dir / f"{filename}.backup.{datetime.now().strftime('%Y%m%d_%H%M%S')}"
            config_file.rename(backup_file)
            print(f"기존 설정 파일 백업: {backup_file}")
        
        # 새 설정 파일 생성
        config_data['last_updated'] = datetime.now().isoformat()
        with open(config_file, 'w', encoding='utf-8') as f:
            json.dump(config_data, f, ensure_ascii=False, indent=2)
        print(f"설정 파일 생성: {config_file}")

