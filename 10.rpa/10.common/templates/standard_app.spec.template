# ==================== 자원 파일 수집 ====================
def collect_resources():
    """앱에 포함할 자원 파일들 수집"""
    datas = []
    
    # 1. Google Service Account 키 파일 포함
    google_creds = COMMON_DIR / 'credentials' / 'google-service-account.json'
    if google_creds.exists():
        datas.append((str(google_creds), 'credentials'))
        print(f"✓ Google credentials 포함: {google_creds}")
    else:
        print(f"⚠ Google credentials 누락: {google_creds}")
    
    # 2. 앱별 리소스 파일 포함
    app_res_dir = APP_ROOT / 'res'
    if app_res_dir.exists():
        for file_path in app_res_dir.rglob('*'):
            if file_path.is_file() and not file_path.name.startswith('.'):
                rel_path = file_path.relative_to(app_res_dir)
                datas.append((str(file_path), f'res/{rel_path.parent}' if rel_path.parent != Path('.') else 'res'))
        print(f"✓ 앱 리소스 포함: {app_res_dir}")
    
    # 3. 공통 설정 템플릿 포함 (선택사항)
    common_templates = COMMON_DIR / 'templates'
    if common_templates.exists():
        for file_path in common_templates.rglob('*.json'):
            if file_path.is_file():
                rel_path = file_path.relative_to(common_templates)
                datas.append((str(file_path), f'templates/{rel_path.parent}' if rel_path.parent != Path('.') else 'templates'))
        print(f"✓ 공통 템플릿 포함: {common_templates}")
    
    return datas

